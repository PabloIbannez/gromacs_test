integrator              = steep
nsteps                  = 5000
emtol                   = 100.0
emstep                  = 0.01
cutoff-scheme           = Verlet
nstlist                 = 20
coulombtype             = Cut-off
coulomb-modifier        = Potential-shift
rlist                   = 1.0
rvdw                    = 1.0
rcoulomb                = 1.0
constraints             = h-bonds
constraint-algorithm    = lincs
pbc                     = xyz
