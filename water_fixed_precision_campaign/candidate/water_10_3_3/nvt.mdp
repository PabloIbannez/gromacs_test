integrator              = md
nsteps                  = 10000
dt                      = 0.002
nstfout                 = 0
nstxout                 = 0
nstvout                 = 0
nstxout-compressed      = 0
nstcalcenergy           = 100
nstcomm                 = 100
nstenergy               = 100
nstlog                  = 100
constraints             = h-bonds
constraint-algorithm    = lincs
cutoff-scheme           = Verlet
nstlist                 = 20
coulombtype             = PME
fourierspacing          = 0.12
pme-order               = 4
rlist                   = 1.0
rvdw                    = 1.0
rcoulomb                = 1.0
tcoupl                  = v-rescale
tc-grps                 = System
tau-t                   = 1.0
ref-t                   = 300
pcoupl                  = no
gen-vel                 = yes
gen-temp                = 300
gen-seed                = -1
pbc                     = xyz
